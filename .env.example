TELEGRAM_BOT_TOKEN=
# JSON array of numeric Telegram user IDs, e.g. [123456789]
ALLOWED_TELEGRAM_USER_IDS=[]
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint. Leave blank for the OpenAI API.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4-nano
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
# Optional exact Home Assistant entity label name. Blank disables indicator filtering.
DOUGAL_INDICATOR_LABEL=
# Optional full URL of a self-hosted OpenAI-compatible transcription endpoint.
DOUGAL_VOICE_TRANSCRIPTION_URL=
DOUGAL_VOICE_TRANSCRIPTION_MODEL=whisper-1
# Optional bearer token for the transcription service, separate from OPENAI_API_KEY.
DOUGAL_VOICE_TRANSCRIPTION_API_KEY=
